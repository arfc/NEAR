<simulation xmlns:xi="http://www.w3.org/2001/XInclude">
  <control>
    <decay>lazy</decay>
    <duration>24</duration>
    <startmonth>1</startmonth>
    <startyear>2020</startyear>
  </control>
  <archetypes>
    <spec>
      <lib>cycamore</lib>
      <name>Enrichment</name>
    </spec>
    <spec>
      <lib>cycamore</lib>
      <name>TODReactor</name>
    </spec>
    <spec>
      <lib>cycamore</lib>
      <name>Sink</name>
    </spec>
    <spec>
      <lib>cycamore</lib>
      <name>Source</name>
    </spec>
    <spec>
      <lib>cycamore</lib>
      <name>Storage</name>
    </spec>
    <spec>
      <lib>cycamore</lib>
      <name>ManagerInst</name>
    </spec>
    <spec>
      <lib>cycamore</lib>
      <name>DeployInst</name>
    </spec>
    <spec>
      <lib>agents</lib>
      <name>NullRegion</name>
    </spec>
    <spec>
      <lib>agents</lib>
      <name>NullInst</name>
    </spec>
  </archetypes>


  <facility>
    <name>Source</name>
    <config>
      <Source>
        <outcommod>fresh_uox</outcommod>
        <outrecipe>fresh_uox</outrecipe>
        <!-- Cameco Smith Ranch-Highland Mine -->
        <latitude>43.053736</latitude>
        <longitude>-105.685089</longitude>
      </Source>
    </config>
  </facility>


  <facility>
      <name>TOD_Reactor</name>
      <lifetime>18</lifetime>
      <config>
      <TODReactor>
          <fuel_incommods> <val>fresh_uox</val> </fuel_incommods>
          <fuel_inrecipes> <val>fresh_uox</val> </fuel_inrecipes>
          <fuel_outcommods> <val>used_uox</val> </fuel_outcommods>
          <fuel_outrecipes> <val>used_uox</val> </fuel_outrecipes>
          <cycle_time>3</cycle_time>
          <refuel_time>2</refuel_time>
          <assem_size>33000</assem_size>
          <n_assem_core>3</n_assem_core>
          <n_assem_batch>1</n_assem_batch>
          <power_cap>1000</power_cap> <!-- in MWe -->
      </TODReactor>
      </config>
  </facility>



  <facility>
    <name>Sink</name>
    <config>
      <Sink>
        <in_commods>
          <val>used_uox</val>
        </in_commods>
        <!-- Yucca Mountain Repository -->
        <latitude>36.8286</latitude>
        <longitude>-116.4364</longitude>
      </Sink>
    </config>
  </facility>

  <region>
    <name>United States</name>
    <config>
      <NullRegion/>
    </config>

    <institution>
      <name>FuelCycle</name>
      <initialfacilitylist>
        <entry>
          <prototype>Source</prototype>
          <number>20</number>
        </entry>
        <entry>
          <prototype>Sink</prototype>
          <number>20</number>
        </entry>
        <entry>
          <prototype>TOD_Reactor</prototype>
          <number>100</number>
        </entry>
      </initialfacilitylist>
      <config>
	    <DeployInst>
          <prototypes>
            <val>TOD_Reactor</val>
            <val>TOD_Reactor</val>
            <val>TOD_Reactor</val>
            <val>TOD_Reactor</val>
            <val>TOD_Reactor</val>
            <val>TOD_Reactor</val>
            <val>TOD_Reactor</val>
            <val>TOD_Reactor</val>
            <val>TOD_Reactor</val>
          </prototypes>
          <build_times>
            <val>1</val>
            <val>2</val>
            <val>3</val>
            <val>4</val>
            <val>5</val>
            <val>6</val>
            <val>7</val>
            <val>8</val>
            <val>9</val>
          </build_times>
          <n_build>
            <val>100</val>
            <val>100</val>
            <val>100</val>
            <val>100</val>
            <val>100</val>
            <val>100</val>
            <val>100</val>
            <val>100</val>
            <val>100</val>
          </n_build>
        </DeployInst>
      </config>
    </institution>
  </region>

<!-- Table 10 from https://www.oecd-nea.org/jcms/pl_19182/benchmark-study-on-nuclear-fuel-cycle-transition-scenarios-analysis-codes?details=true -->
  <recipe>
    <name>fresh_uox</name>
    <basis>mass</basis>
    <nuclide>
        <id>92235</id>
        <comp>0.0495</comp>
    </nuclide>
    <nuclide>
        <id>92238</id>
        <comp>0.950055</comp>
    </nuclide>
    <nuclide>
      <id>92234</id>
      <comp>0.0445</comp>
    </nuclide>
  </recipe>

  <recipe>
    <name>used_uox</name>
    <basis>mass</basis>
    <nuclide>
      <id>92235</id>
      <comp>0.0011</comp>
    </nuclide>
    <nuclide>
      <id>92238</id>
      <comp>0.94</comp>
    </nuclide>
    <nuclide>
      <id>94239</id>
      <comp>0.009</comp>
    </nuclide>
    <nuclide>
      <id>55137</id>
      <comp>0.04</comp>
    </nuclide>
  </recipe>
</simulation>
